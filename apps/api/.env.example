SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_DB_URL=

APP_ENV=production
JUDGE0_DEV_ENABLED=false
# Generate a dedicated local bearer token with secrets.token_urlsafe(32).
JUDGE0_DEV_TOKEN=
# Set the fixed Tailscale Serve URL and find its Python ID via GET /languages.
JUDGE0_BASE_URL=
JUDGE0_PYTHON_LANGUAGE_ID=
# Optional Judge0 X-Auth-Token. Keep it distinct from JUDGE0_DEV_TOKEN.
JUDGE0_AUTH_TOKEN=
JUDGE0_REQUEST_TIMEOUT=3
JUDGE0_MAX_POLL_SECONDS=15
JUDGE0_MAX_POLL_ATTEMPTS=30
